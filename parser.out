Rule 13    if_statement -> IF LPAREN expression RPAREN statement
Rule 14    if_statement -> IF LPAREN expression RPAREN statement ELSE statement
Rule 15    for_statement -> FOR LPAREN expression SEMICOLON expression SEMICOLON expression RPAREN statement
Rule 16    while_statement -> WHILE LPAREN expression RPAREN statement
Rule 17    echo_statement -> ECHO expression SEMICOLON
Rule 18    print_statement -> PRINT expression SEMICOLON
Rule 19    function_declaration -> FUNCTION ID LPAREN parameter_list RPAREN LBLOCK statement_list RBLOCK
Rule 20    parameter_list -> parameter_list COMMA VARIABLE
Rule 21    parameter_list -> VARIABLE
Rule 22    parameter_list -> empty
Rule 23    expression -> ID LPAREN argument_list RPAREN
Rule 24    expression -> VARIABLE LPAREN argument_list RPAREN
Rule 25    argument_list -> argument_list COMMA expression
Rule 26    argument_list -> expression
Rule 27    argument_list -> empty
Rule 28    expression -> expression PLUS expression
Rule 29    expression -> expression MINUS expression
Rule 30    expression -> expression TIMES expression
Rule 31    expression -> expression MODULE expression
Rule 32    expression -> expression DOT expression
Rule 33    expression -> expression ISEQUAL expression
Rule 34    expression -> expression NOTISEQUAL expression
Rule 35    expression -> expression GREATERTHAN expression
Rule 36    expression -> expression LESSTHAN expression
Rule 37    expression -> expression GREATERTHANEQUAL expression
Rule 38    expression -> expression LESSEQUAL expression
Rule 39    expression -> expression AND expression
Rule 40    expression -> expression OR expression
Rule 41    expression -> MINUS expression
Rule 42    expression -> VARIABLE INCREMENT
Rule 43    expression -> VARIABLE DECREMENT
Rule 44    expression -> LPAREN expression RPAREN
Rule 45    expression -> NUMBER
Rule 46    expression -> VARIABLE
Rule 47    expression -> STRING
Rule 48    expression -> BOOLEAN
Rule 49    expression -> VARIABLE EQUAL expression
Rule 50    empty -> <empty>

